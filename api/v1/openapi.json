{
  "openapi": "3.1.0",
  "info": {
    "title": "Lead Green Green Tokens API",
    "version": "1",
    "summary": "GPU energy per million output tokens, grid carbon, GPU hardware.",
    "description": "Static JSON files. GET only. No authentication. CORS open. Additive changes only within v1.",
    "license": {
      "name": "CC BY 4.0",
      "url": "https://creativecommons.org/licenses/by/4.0/"
    }
  },
  "servers": [
    {
      "url": "https://leadgreen.ai/api/v1"
    }
  ],
  "paths": {
    "/manifest.json": {
      "get": {
        "summary": "Sources, versions, retrieval dates, licences and this endpoint list.",
        "responses": {
          "200": {
            "description": "Manifest",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/index.json": {
      "get": {
        "summary": "The index: 32 rows, one per model and GPU, energy-optimal under the latency limit, sorted ascending.",
        "responses": {
          "200": {
            "description": "Index",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Index"
                }
              }
            }
          }
        }
      }
    },
    "/models.json": {
      "get": {
        "summary": "Every model on the index with its slug, Hugging Face id, parameter counts and measured GPUs.",
        "responses": {
          "200": {
            "description": "Models",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/models/{slug}.json": {
      "get": {
        "summary": "One model: every measured configuration (concurrency, parallelism, latency, power) and the best row per GPU.",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "qwen-3-32b"
          }
        ],
        "responses": {
          "200": {
            "description": "Model",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "404": {
            "description": "Unknown slug"
          }
        }
      }
    },
    "/grid.json": {
      "get": {
        "summary": "Grid emissions intensity, gCO2e per kWh, 2024 annual average, 193 countries plus World.",
        "responses": {
          "200": {
            "description": "Grid",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/hardware.json": {
      "get": {
        "summary": "Manufacturer power ceilings, memory, MIG slice profiles and one embodied-carbon figure.",
        "responses": {
          "200": {
            "description": "Hardware",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/per-query.json": {
      "get": {
        "summary": "AI Energy Score text-generation rows, December 2025 round: Wh per 1,000 queries at batch size 1 on H100 80GB GPUs (one card for classes A and B, several for C).",
        "responses": {
          "200": {
            "description": "Per query",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "IndexRow": {
        "type": "object",
        "properties": {
          "model": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "model_id": {
            "type": "string"
          },
          "params_b": {
            "type": "number"
          },
          "active_params_b": {
            "type": "number"
          },
          "precision": {
            "type": "string"
          },
          "gpu": {
            "type": "string",
            "enum": [
              "H100",
              "B200"
            ]
          },
          "num_gpus": {
            "type": "integer"
          },
          "wh_per_million_output_tokens": {
            "type": "number"
          },
          "joules_per_output_token": {
            "type": "number"
          },
          "median_itl_ms": {
            "type": "number"
          },
          "avg_requests_in_flight": {
            "type": "number"
          },
          "gpu_power_watts_total": {
            "type": "number"
          },
          "avg_output_tokens": {
            "type": "number"
          }
        }
      },
      "Index": {
        "type": "object",
        "properties": {
          "version": {
            "type": "string"
          },
          "updated": {
            "type": "string",
            "format": "date"
          },
          "unit": {
            "type": "string"
          },
          "workload": {
            "type": "string"
          },
          "itl_deadline_ms": {
            "type": "integer"
          },
          "source": {
            "type": "object"
          },
          "caveat": {
            "type": "string"
          },
          "rows": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/IndexRow"
            }
          }
        }
      }
    }
  }
}
